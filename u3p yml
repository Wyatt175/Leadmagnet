# Runs the U3P collector every 3 hours, plus a "Run workflow" button for manual runs.
name: Collect U3P bids

on:
  schedule:
    - cron: "0 */3 * * *"   # every 3 hours (GitHub uses UTC time)
  workflow_dispatch:         # adds the manual "Run workflow" button

jobs:
  collect:
    runs-on: ubuntu-latest
    steps:
      - name: Get the code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install packages
        run: pip install -r collector/requirements.txt

      - name: Install the hidden browser
        run: python -m playwright install --with-deps chromium

      - name: Run the collector
        run: python collector/collect_u3p.py
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}

      - name: Save the debug screenshot
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: u3p-debug
          path: debug/
          retention-days: 7
